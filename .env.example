# Telegram VPS Monitor Mini App
DASHBOARD_PASSWORD=change-me
HOST=127.0.0.1
PORT=8787
REFRESH_SECONDS=1
DEBUG=false

# Telegram Mini App auth
# Set to your own Telegram numeric user ID.
ALLOWED_TG_USER_ID=123456789
# Optional direct Bot API alerts. Leave empty if using your own notifier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=-1003869687513
TELEGRAM_ALERT_THREAD_ID=7
ALERT_COOLDOWN_SECONDS=300
# HTTPS public dashboard URL for bot menu/button
BOT_PUBLIC_URL=https://your-domain.example

# Terminal security
# Empty = no PIN. Recommended: rely on Telegram initData auth + private tunnel/access layer.
TERMINAL_PIN=
TERMINAL_PASSWORD_FALLBACK=false

# Alert thresholds
ALERT_RAM_PCT=85
ALERT_DISK_PCT=85
ALERT_LOAD_PER_CORE=2.0

# Multi VPS (panel/main)
VPS_LOCAL_NAME=Main VPS
VPS_TARGETS=[{"id":"node1","name":"Node 1","url":"http://IP_NODE_1:8788","password":"nodepass1"},{"id":"node2","name":"Node 2","url":"http://IP_NODE_2:8788","password":"nodepass2"}]

# Node agent mode (remote node)
NODE_PASSWORD=change-me-node
NODE_HOST=0.0.0.0
NODE_PORT=8788
# Optional service checks JSON array
# NODE_SERVICE_CHECKS=[{"name":"Nginx","cmd":"systemctl is-active --quiet nginx"}]
